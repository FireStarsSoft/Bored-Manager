#!/bin/sh
set -eu

if command -v systemctl >/dev/null 2>&1; then
    systemctl daemon-reload >/dev/null 2>&1 || true
fi

if [ "${1:-}" = "purge" ]; then
    echo "Bored Manager agent identity and monitored services were preserved." >&2
    echo "Use the audited bmctl purge workflow before removing preserved state." >&2
fi

exit 0
