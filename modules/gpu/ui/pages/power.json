{
  "blocks": [
    {
      "type": "conditional",
      "when": { "source": { "kind": "stream", "event": "snapshot", "path": "available" }, "op": "eq", "value": true },
      "blocks": [
        {
          "type": "section",
          "title": "Auto power cap",
          "blocks": [
            {
              "type": "keyValue",
              "source": { "kind": "stream", "event": "autocap" },
              "rows": [
                { "key": "enabled", "label": "Enabled" },
                { "key": "gpuIndex", "label": "GPU" },
                { "key": "idleCap", "label": "Idle cap (W)", "format": "number" },
                { "key": "runningCap", "label": "Running cap (W)", "format": "number" },
                { "key": "intervalSec", "label": "Check interval (s)", "format": "number" },
                { "key": "currentCap", "label": "Current cap (W)", "format": "number" }
              ]
            },
            {
              "type": "form",
              "fields": [
                { "key": "gpuIndex", "label": "GPU index", "input": "number" },
                { "key": "idleCap", "label": "Idle cap (W)", "input": "number" },
                { "key": "runningCap", "label": "Running cap (W)", "input": "number" },
                { "key": "intervalSec", "label": "Check interval (s)", "input": "number" }
              ],
              "submit": {
                "label": "Start",
                "method": "autoCapStart",
                "confirm": "Watch Docker and switch this GPU's power cap between the idle and running values automatically?"
              }
            },
            {
              "type": "actions",
              "actions": [{ "label": "Stop", "method": "autoCapStop", "kind": "danger" }]
            }
          ]
        },
        {
          "type": "section",
          "title": "GPUs",
          "blocks": [
            {
              "type": "table",
              "source": { "kind": "stream", "event": "snapshot", "path": "gpus" },
              "columns": [
                { "key": "index", "label": "#", "align": "right" },
                { "key": "name", "label": "Name" },
                { "key": "powerLimit", "label": "Power limit (W)", "format": "number", "align": "right" },
                { "key": "persistence", "label": "Persistence" },
                { "key": "clockSm", "label": "SM clock (MHz)", "format": "number", "align": "right" },
                { "key": "clockMem", "label": "Mem clock (MHz)", "format": "number", "align": "right" }
              ],
              "sortDefault": { "key": "index", "dir": "asc" },
              "emptyText": "No NVIDIA GPU detected",
              "rowDetail": [
                {
                  "type": "form",
                  "fields": [{ "key": "watts", "label": "Power limit (W)", "input": "number" }],
                  "submit": { "label": "Set power limit", "method": "setPowerLimit", "argsFromRow": ["index"] }
                },
                {
                  "type": "actions",
                  "actions": [
                    { "label": "Enable persistence", "method": "setPersistence", "argsFromRow": ["index"], "args": [true] },
                    { "label": "Disable persistence", "method": "setPersistence", "argsFromRow": ["index"], "args": [false] }
                  ]
                },
                {
                  "type": "form",
                  "fields": [
                    { "key": "min", "label": "Min clock (MHz)", "input": "number" },
                    { "key": "max", "label": "Max clock (MHz)", "input": "number" }
                  ],
                  "submit": { "label": "Lock clocks", "method": "lockClocks", "argsFromRow": ["index"] }
                },
                {
                  "type": "actions",
                  "actions": [{ "label": "Reset clocks", "method": "resetClocks", "argsFromRow": ["index"] }]
                }
              ]
            }
          ]
        }
      ],
      "else": [
        {
          "type": "section",
          "title": "No NVIDIA GPU detected on the target (nvidia-smi not available), or waiting for the first reading.",
          "blocks": []
        }
      ]
    }
  ]
}
