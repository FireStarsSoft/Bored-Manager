{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/FireStarsSoft/Bored-Manager/blob/main/docs/release/release-manifest-v1.schema.json",
  "title": "Bored Manager release manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "release",
    "source",
    "compatibility",
    "artifacts"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "tag", "channel", "published_at"],
      "properties": {
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$" },
        "tag": { "type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$" },
        "channel": { "enum": ["prerelease", "stable"] },
        "published_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit"],
      "properties": {
        "repository": { "const": "https://github.com/FireStarsSoft/Bored-Manager" },
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operating_systems", "architecture", "manager_supports_agent"],
      "properties": {
        "operating_systems": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "prefixItems": [
            { "const": "kali-rolling" },
            { "const": "ubuntu-24.04" }
          ],
          "items": false
        },
        "architecture": { "const": "amd64" },
        "manager_supports_agent": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+(?:\\.x)?$" }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 7,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "kind", "component", "sha256", "size"],
        "properties": {
          "name": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*$" },
          "kind": {
            "enum": ["installer", "debian-package", "checksums", "sbom", "provenance"]
          },
          "component": { "enum": ["manager", "agent", "release"] },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "size": { "type": "integer", "minimum": 1 },
          "package": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "version", "architecture"],
            "properties": {
              "name": { "enum": ["bored-manager", "bored-manager-agent"] },
              "version": { "type": "string", "minLength": 1 },
              "architecture": { "const": "amd64" }
            }
          }
        },
        "allOf": [
          {
            "if": { "properties": { "kind": { "const": "debian-package" } } },
            "then": { "required": ["component", "package"] }
          }
        ]
      }
    }
  }
}
