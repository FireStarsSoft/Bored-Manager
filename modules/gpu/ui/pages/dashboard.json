{
  "blocks": [
    {
      "type": "conditional",
      "when": { "source": { "kind": "stream", "event": "snapshot", "path": "available" }, "op": "eq", "value": true },
      "blocks": [
        {
          "type": "section",
          "title": "GPU",
          "columns": 4,
          "blocks": [
            {
              "type": "stat",
              "label": "Utilization",
              "source": { "kind": "stream", "event": "snapshot", "path": "gpus.0.utilization" },
              "format": "pct",
              "spark": { "source": { "kind": "stream", "event": "series" }, "key": "util" }
            },
            {
              "type": "stat",
              "label": "VRAM used (MiB)",
              "source": { "kind": "stream", "event": "snapshot", "path": "gpus.0.memUsedMiB" },
              "format": "number",
              "spark": { "source": { "kind": "stream", "event": "series" }, "key": "vram" }
            },
            {
              "type": "stat",
              "label": "Temperature",
              "source": { "kind": "stream", "event": "snapshot", "path": "gpus.0.temp" },
              "format": "temp",
              "spark": { "source": { "kind": "stream", "event": "series" }, "key": "temp" }
            },
            {
              "type": "stat",
              "label": "Power draw (W)",
              "source": { "kind": "stream", "event": "snapshot", "path": "gpus.0.powerDraw" },
              "format": "number",
              "spark": { "source": { "kind": "stream", "event": "series" }, "key": "draw" }
            }
          ]
        },
        {
          "type": "section",
          "columns": 2,
          "blocks": [
            {
              "type": "chart",
              "title": "Utilization",
              "kind": "area",
              "source": { "kind": "stream", "event": "series" },
              "format": "pct",
              "series": [{ "key": "util", "label": "Utilization" }]
            },
            {
              "type": "chart",
              "title": "VRAM (MiB)",
              "kind": "area",
              "source": { "kind": "stream", "event": "series" },
              "series": [
                { "key": "vram", "label": "Used" },
                { "key": "vramTotal", "label": "Total" }
              ]
            },
            {
              "type": "chart",
              "title": "Temperature",
              "kind": "area",
              "source": { "kind": "stream", "event": "series" },
              "format": "temp",
              "series": [{ "key": "temp", "label": "Temperature" }]
            },
            {
              "type": "chart",
              "title": "Power",
              "kind": "area",
              "source": { "kind": "stream", "event": "series" },
              "series": [
                { "key": "draw", "label": "Draw", "unit": "W" },
                { "key": "limit", "label": "Limit", "unit": "W" }
              ]
            }
          ]
        },
        {
          "type": "section",
          "title": "Compute processes",
          "blocks": [
            {
              "type": "table",
              "source": { "kind": "stream", "event": "snapshot", "path": "processes" },
              "rowKey": "pid",
              "columns": [
                { "key": "gpuIndex", "label": "GPU", "align": "right" },
                { "key": "pid", "label": "PID", "align": "right" },
                { "key": "name", "label": "Process" },
                { "key": "memMiB", "label": "VRAM (MiB)", "format": "number", "align": "right" }
              ],
              "sortDefault": { "key": "memMiB", "dir": "desc" },
              "filterKeys": ["name"],
              "rowActions": [
                {
                  "label": "Kill",
                  "method": "killProcess",
                  "argsFromRow": ["pid"],
                  "confirm": "Send SIGKILL to this process? This may need sudo if it belongs to another user.",
                  "kind": "danger"
                }
              ],
              "emptyText": "No compute processes are using the GPU"
            }
          ]
        }
      ],
      "else": [
        {
          "type": "section",
          "title": "No NVIDIA GPU detected on the target (nvidia-smi not available), or waiting for the first reading.",
          "blocks": []
        }
      ]
    }
  ]
}
