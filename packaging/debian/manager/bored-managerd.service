[Unit]
Description=Bored Manager control plane
Documentation=https://github.com/FireStarsSoft/Bored-Manager
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=bored-manager
Group=bored-manager
EnvironmentFile=-/etc/default/bored-manager
LoadCredentialEncrypted=agent-ca.key
ExecStart=/usr/bin/bored-managerd
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
KillMode=mixed
UMask=0027

RuntimeDirectory=bored-manager
RuntimeDirectoryMode=0750
StateDirectory=bored-manager
StateDirectoryMode=0750
CacheDirectory=bored-manager
CacheDirectoryMode=0750

NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=strict
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
