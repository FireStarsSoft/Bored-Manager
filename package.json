{
  "name": "bored-manager",
  "version": "0.3.5",
  "description": "Bored Manager - web UI for Linux system processes, network, disk, sensors, packages, GPU, containers (Docker/Incus) and systemd services - local or remote over SSH",
  "type": "module",
  "private": true,
  "scripts": {
    "predev": "node scripts/licenses.mjs",
    "dev": "vite",
    "dev:server": "BM_DEV=1 tsx watch --tsconfig tsconfig.node.json server/index.ts",
    "prebuild": "node scripts/licenses.mjs",
    "build": "vite build && vite build --config vite.config.server.ts",
    "build:renderer": "vite build",
    "build:server": "vite build --config vite.config.server.ts",
    "start": "node out/server/index.mjs",
    "pretypecheck": "node scripts/licenses.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.test.json",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:scripts": "tsx scripts/check-protocol-contract.ts",
    "test": "npm run test:unit && npm run test:integration && npm run test:scripts",
    "check": "npm run typecheck && npm test",
    "modules:lock": "node scripts/modules-lock.mjs",
    "modules:verify": "node scripts/modules-lock.mjs --check",
    "modules:pack": "node scripts/package-module.mjs",
    "modules:specs": "tsx scripts/check-specs.mjs",
    "modules:compile": "tsx scripts/compile-modules.mjs"
  },
  "author": "",
  "license": "Apache-2.0",
  "dependencies": {
    "@tanstack/react-table": "^9.1.2",
    "@tanstack/react-virtual": "^3.14.9",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "esbuild": "^0.28.2",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "lucide-react": "^1.23.0",
    "multer": "^2.2.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-grid-layout": "^2.2.3",
    "recharts": "^3.9.2",
    "session-file-store": "^1.5.0",
    "sonner": "^2.0.8",
    "ssh2": "^1.17.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "ws": "^8.21.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.1.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/session-file-store": "^1.2.6",
    "@types/ssh2": "^1.15.5",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.2.0",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.2",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  },
  "optionalDependencies": {
    "node-pty": "^1.1.0"
  }
}
