{
  "apiVersion": 2,
  "id": "hello",
  "name": "Hello",
  "version": "2.0.0",
  "description": "A worked example of a v2 module: one poller, a confirm-gated action, two pages and one Overview widget. Shows the target machine's uptime and kernel.",
  "author": "Bored Manager",
  "minAppVersion": "0.0.1",
  "entries": {
    "main": "main/index.ts"
  },
  "pages": [
    { "id": "main", "label": "Hello", "icon": "Sparkles", "order": 65 },
    { "id": "details", "label": "Details", "icon": "Info", "order": 66 }
  ],
  "widgets": [{ "id": "summary", "label": "Hello", "defaultEnabled": true, "order": 45 }],
  "streams": [
    { "event": "snapshot", "kind": "latest" },
    { "event": "series", "kind": "series" }
  ],
  "methods": ["reboot"],
  "fastInterval": "system"
}
