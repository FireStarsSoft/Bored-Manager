{
  "blocks": [
    {
      "type": "conditional",
      "when": { "source": { "kind": "stream", "event": "snapshot", "path": "sensors.0" }, "op": "exists" },
      "blocks": [
        {
          "type": "section",
          "title": "History",
          "columns": 2,
          "blocks": [
            {
              "type": "conditional",
              "when": { "source": { "kind": "stream", "event": "temps", "path": "0" }, "op": "exists" },
              "blocks": [
                {
                  "type": "chart",
                  "title": "Temperature",
                  "kind": "area",
                  "source": { "kind": "stream", "event": "temps" },
                  "format": "temp",
                  "maxSeries": 8
                }
              ]
            },
            {
              "type": "conditional",
              "when": { "source": { "kind": "stream", "event": "fans", "path": "0" }, "op": "exists" },
              "blocks": [
                {
                  "type": "chart",
                  "title": "Fans",
                  "kind": "area",
                  "source": { "kind": "stream", "event": "fans" },
                  "unit": "RPM",
                  "maxSeries": 8
                }
              ]
            },
            {
              "type": "conditional",
              "when": { "source": { "kind": "stream", "event": "voltages", "path": "0" }, "op": "exists" },
              "blocks": [
                {
                  "type": "chart",
                  "title": "Voltage",
                  "kind": "area",
                  "source": { "kind": "stream", "event": "voltages" },
                  "unit": "V",
                  "decimals": 2,
                  "maxSeries": 8
                }
              ]
            },
            {
              "type": "conditional",
              "when": { "source": { "kind": "stream", "event": "power", "path": "0" }, "op": "exists" },
              "blocks": [
                {
                  "type": "chart",
                  "title": "Power",
                  "kind": "area",
                  "source": { "kind": "stream", "event": "power" },
                  "unit": "W",
                  "decimals": 1,
                  "maxSeries": 8
                }
              ]
            },
            {
              "type": "conditional",
              "when": { "source": { "kind": "stream", "event": "current", "path": "0" }, "op": "exists" },
              "blocks": [
                {
                  "type": "chart",
                  "title": "Current",
                  "kind": "area",
                  "source": { "kind": "stream", "event": "current" },
                  "unit": "A",
                  "decimals": 2,
                  "maxSeries": 8
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "section",
      "title": "Sensors",
      "blocks": [
        {
          "type": "table",
          "source": { "kind": "stream", "event": "snapshot", "path": "sensors" },
          "columns": [
            { "key": "label", "label": "Sensor" },
            { "key": "chip", "label": "Chip" },
            { "key": "kind", "label": "Kind" },
            { "key": "value", "label": "Value", "align": "right" },
            { "key": "unit", "label": "Unit" },
            { "key": "crit", "label": "Crit", "align": "right" },
            { "key": "max", "label": "Max", "align": "right" }
          ],
          "sortDefault": { "key": "kind", "dir": "asc" },
          "filterKeys": ["label", "chip", "kind"],
          "groupModes": [{ "id": "kind", "label": "By kind", "key": "kind" }],
          "emptyText": "No sensor readings. This machine may expose none (no lm-sensors and no readable /sys/class/hwmon - common in VMs and containers), or polling is paused in Settings \u2192 Update intervals \u2192 Sensors."
        }
      ]
    }
  ]
}
